# API Configuration
VITE_API_URL=http://localhost/api
VITE_API_BASE_URL=http://localhost

# WebSocket Configuration
VITE_WS_URL=http://localhost:3001
VITE_WS_PATH=/socket.io/

# Application
VITE_APP_NAME="Case Platform"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Steam Integration
VITE_STEAM_RETURN_URL=http://localhost/auth/steam/return

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_HOT_JAR=false

# Analytics
VITE_GA_TRACKING_ID=
VITE_YANDEX_METRICA_ID=

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# HotJar
VITE_HOTJAR_ID=

# Platform Configuration
VITE_PLATFORM_CURRENCY=USD
VITE_PLATFORM_LOCALE=en
VITE_PLATFORM_TIMEZONE=UTC

# Social Links
VITE_SOCIAL_TELEGRAM=https://t.me/case_platform
VITE_SOCIAL_DISCORD=https://discord.gg/case_platform
VITE_SOCIAL_TWITTER=https://twitter.com/case_platform

# Support
VITE_SUPPORT_EMAIL=support@case-platform.com
VITE_SUPPORT_TELEGRAM=@case_platform_support

# CDN
VITE_CDN_URL=
VITE_ASSETS_URL=

# PWA
VITE_PWA_NAME="Case Platform"
VITE_PWA_SHORT_NAME="CasePlatform"
VITE_PWA_DESCRIPTION="Open cases and win amazing items"
VITE_PWA_THEME_COLOR=#3b82f6
VITE_PWA_BACKGROUND_COLOR=#ffffff