APP_NAME="Case Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=case_platform
DB_USERNAME=case_user
DB_PASSWORD=case_password

BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@case-platform.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Steam Integration
STEAM_API_KEY=your_steam_api_key
STEAM_CLIENT_ID=your_steam_client_id
STEAM_CLIENT_SECRET=your_steam_client_secret
STEAM_REDIRECT_URI=http://localhost/auth/steam/callback

# WebSocket Server
WEBSOCKET_HOST=websocket
WEBSOCKET_PORT=3001

# Payment Gateways
QIWI_SECRET_KEY=your_qiwi_secret
YOOMONEY_CLIENT_ID=your_yoomoney_client_id
YOOMONEY_CLIENT_SECRET=your_yoomoney_secret
CRYPTO_BOT_TOKEN=your_crypto_bot_token

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Laravel Telescope
TELESCOPE_ENABLED=true

# Provably Fair
PROVABLY_FAIR_SERVER_SEED_PREFIX=case_platform_
PROVABLY_FAIR_MIN_CLIENT_SEED_LENGTH=8

# Anti-Minus System
ANTI_MINUS_ENABLED=true
ANTI_MINUS_THRESHOLD=-100
ANTI_MINUS_BOOST_MULTIPLIER=1.2

# Rate Limiting
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5

# File Upload
MAX_UPLOAD_SIZE=10240
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx

# Case Platform Specific
PLATFORM_NAME="Case Platform"
PLATFORM_CURRENCY=USD
PLATFORM_COMMISSION=0.05
PLATFORM_MIN_WITHDRAWAL=10
PLATFORM_MAX_WITHDRAWAL=10000

# Frontend URL
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost/admin

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With