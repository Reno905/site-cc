NODE_ENV=development
PORT=3001

# Database
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=case_platform
DB_USERNAME=case_user
DB_PASSWORD=case_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT
JWT_SECRET=your_jwt_secret_key_here

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/websocket.log

# Socket.io
SOCKET_IO_ADAPTER=redis
SOCKET_IO_REDIS_HOST=redis
SOCKET_IO_REDIS_PORT=6379
SOCKET_IO_REDIS_PASSWORD=redis_password

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# Laravel Backend Integration
LARAVEL_API_URL=http://php:9000
LARAVEL_API_SECRET=your_laravel_api_secret

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=3002